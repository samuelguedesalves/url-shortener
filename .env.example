# Copy to .env (git-ignored). `docker compose` reads it automatically.
# Values below are local-dev settings; the two secrets are commented out on purpose (see there).

# OAuth Web Client ID from Google Cloud Console (README, "Dashboard"), shaped like
# <your-client-id>.apps.googleusercontent.com. Empty: the dashboard shows "login not configured"
# and every sign-in fails closed.
GOOGLE_CLIENT_ID=

# SECRET_KEY_BASE and SESSION_SECRET: left commented out, docker-compose.yml applies its dev
# defaults. Those defaults are public, dev-only values: anyone who can reach write-api could forge
# a session cookie with them. Set real random values before exposing the port beyond localhost
# (for example to reach it from other machines on a LAN).

# Signs LiveView and CSRF tokens. 64 bytes or more; write_api refuses to boot in prod without it.
# Generate one with: openssl rand -base64 64 | tr -d '\n'
# SECRET_KEY_BASE=

# Signs the session cookie. 32 bytes or more; write_api refuses to boot in prod without it.
# Generate one with: openssl rand -base64 48
# SESSION_SECRET=

# Session lifetime in seconds, also the cookie's max-age (default 7 days).
SESSION_TTL_SECONDS=604800

# Only the string "false" drops the Secure flag from the cookie, for plain-HTTP local runs.
COOKIE_SECURE=false

# The origin the dashboard is served from, written exactly as the browser shows it:
# scheme://host[:port], no trailing slash.
DASHBOARD_ORIGIN=http://localhost:4001

# Public base of the short links returned by the API (redirect-api's origin).
BASE_URL=http://localhost:4002
